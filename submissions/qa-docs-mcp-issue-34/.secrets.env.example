# Secrets (local only — never commit)
# Copy to .secrets.env and fill in real values.

# Full-access PAT for MCP client A (Cursor) and live tool tests
POLLAR_PAT_FULL=pat_...

# Restricted / read-only PAT for 403 negative cases
POLLAR_PAT_READONLY=pat_...

# Testnet API keys from dashboard → Configuration → API Keys
POLLAR_PUBLISHABLE_KEY=pub_testnet_...
POLLAR_SECRET_KEY=sec_testnet_...

# Optional: app id created during QA
POLLAR_APP_ID=
